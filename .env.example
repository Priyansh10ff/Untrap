# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# These are injected into the build. .env is git-ignored: never commit it.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App Check. The extension can't run reCAPTCHA, so it uses a debug token
# (Firebase console > App Check > Apps > your web app > Manage debug tokens).
# Keep it secret: anyone with it can call your AI quota.
APPCHECK_DEBUG_TOKEN=
# The website uses reCAPTCHA Enterprise (App Check > Apps > your web app).
RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional
SITE_URL=
FIRST_PASS_CLOUD_MODEL=gemini-3.5-flash-lite
SECOND_OPINION_MODEL=gemini-3.8-flash
