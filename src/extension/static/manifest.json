{
  "manifest_version": 3,
  "name": "Untrap",
  "short_name": "Untrap",
  "version": "0.1.0",
  "description": "Safe Browsing for AI agents. Finds and removes hidden prompt-injection traps before any AI reads the page.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Untrap",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "offscreen",
    "alarms",
    "activeTab"
  ]
}
